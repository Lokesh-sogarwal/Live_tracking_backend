# Copy to .env for local development. Placeholders only — never commit real values.
NODE_ENV=development
PORT=5001
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Render/Railway: 1)
TRUST_PROXY=0

# MongoDB Atlas connection string (database user with readWrite on this database only)
MONGODB_URI=mongodb://127.0.0.1:27017/live_tracking

# >= 32 random characters in production, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=3h

# Exact frontend origins, comma separated (no wildcards in production)
# Comma-separated exact origins. Vercel preview deployments get a new URL each time; allow them
# with ONE scoped pattern ("*" = letters/digits/dashes in the first label, followed by your team
# suffix), e.g. https://live-tracking-frontend-*-lokesh-sogarwals-projects.vercel.app
FRONTEND_ORIGINS=http://localhost:3000

# Wall-clock timezone for schedule dates and legacy "YYYY-MM-DD HH:MM:SS" strings
APP_TIMEZONE=Asia/Kolkata

# OpenRouteService directions key (leave empty to use the straight-line fallback)
ORS_API_KEY=
# Nominatim requires an identifying User-Agent and rejects example.com contacts (HTTP 403).
# Use your real app name/URL or contact, e.g. "LiveTrackingApp/1.0 (+https://your-domain)".
GEO_USER_AGENT=LiveTrackingApp/1.0
EXTERNAL_HTTP_TIMEOUT_MS=8000
EXTERNAL_HTTP_RETRIES=2

# Driver documents: local (development only) or s3 (required in production)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./var/uploads
UPLOAD_BUCKET=
S3_REGION=us-east-1
# For S3-compatible providers (R2, MinIO, ...)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# AWS credentials come from the standard provider chain:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=5242880
DOWNLOAD_LINK_TTL_SECONDS=900

# Live tracking
LOCATION_STALE_SECONDS=120
LOCATION_MAX_FUTURE_SKEW_SECONDS=30
LOCATION_HISTORY_ENABLED=false
LOCATION_HISTORY_TTL_DAYS=7

# Worker (src/worker.js)
# Run the worker jobs (scheduler + simulation) inside the API process too. Use this on a host
# without background workers, e.g. ONE free Render web service (start command: node src/server.js).
# Leave false when a separate worker runs (npm run start:worker).
RUN_WORKER=false
SCHEDULER_ENABLED=true
# Daily timetable generation (worker): HH:MM in APP_TIMEZONE (Asia/Kolkata). Each run fills
# today + SCHEDULE_DAYS_AHEAD days; missed runs are caught up when the worker starts.
SCHEDULE_CRON_TIME=00:00
SCHEDULE_DAYS_AHEAD=7
SCHEDULE_CATCHUP_ON_START=true
# Publishes simulated bus positions as live locations. Keep false unless demoing.
SIMULATION_ENABLED=false
SIMULATION_TICK_MS=2000

RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_PER_10S=10
CHAT_MAX_MESSAGE_LENGTH=2000
PUBLIC_SIGNUP_ENABLED=true

# Default admin: created when the API starts if this email does not exist yet.
# Changing these later does NOT reset an existing account's password or role.
# Password: at least 12 characters; use a unique random value. Wrap it in double quotes if it
# contains # or spaces (an unquoted # starts a comment in .env files).
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Administrator
# superadmin (can also manage the permission matrix) or admin
DEFAULT_ADMIN_ROLE=superadmin

# scripts/migrate-sql-to-mongo.js (read-only source connection)
# SOURCE_DATABASE_URL=mysql://user:password@host:3306/hackathon

# ---- Email (password reset links, signup codes, application updates, feedback replies) ----
# Provider: Resend when RESEND_API_KEY is set, else SMTP when SMTP_HOST is set, else no email.
# Without email: "forgot password" goes to administrators, passengers sign up without a code,
# driver/operator applications are closed and feedback replies are shown in-app only.
#
# Resend: create an API key at https://resend.com/api-keys (starts with "re_") and verify the
# domain used in MAIL_FROM. For a quick test, MAIL_FROM=onboarding@resend.dev works but Resend
# then only delivers to the email address of your own Resend account.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# e.g. Live Tracking <no-reply@your-domain.example>
MAIL_FROM=
# Base URL of the React app used in emailed links (defaults to the first FRONTEND_ORIGINS entry)
APP_PUBLIC_URL=
PASSWORD_RESET_TTL_MINUTES=30
SIGNUP_CODE_TTL_MINUTES=10
APPLICATION_SESSION_HOURS=12
# Email feedback replies to addresses that were never verified (older accounts). Default: no.
FEEDBACK_EMAIL_UNVERIFIED=false
# Operators must upload an offer/employment letter (proposed default; confirm with the business)
OPERATOR_OFFER_LETTER_REQUIRED=true
