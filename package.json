{
  "name": "live-tracking-backend-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js + Express + MongoDB backend for the Live Tracking & Transport Management System",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate-sql-to-mongo.js",
    "e2e": "node scripts/e2e-smoke.js"
  },
  "dependencies": {
